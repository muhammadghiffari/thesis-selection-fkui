{
  "name": "thesis-selection-fkui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "workers",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n tsc,api,worker,web -c cyan,blue,yellow,green \"npm:watch:server\" \"npm:start:api\" \"npm:start:worker\" \"npm:dev:web\"",
    "watch:server": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start:api": "node --watch dist/src/main.js",
    "start:worker": "node --watch dist/workers/src/main.js",
    "dev:web": "npm run dev --workspace web",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace web",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx src/shared/db/migrate-cli.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/terminus": "^11.1.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.44.7",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}
