# ─── Thesis Selection FKUI — environment ───────────────────────────────
# Copy to .env (local) or inject via your deployment secret store.
# NEVER commit .env. In production the API refuses weak JWT_SECRETs.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/thesis_selection
# Bounded DB pool per process: integer 1..50, default 20 (Neon free friendly).
DB_POOL_MAX=20
# Use the TLS URL from Upstash in production (ioredis accepts rediss:// as-is).
REDIS_URL=redis://localhost:6379

# >=32 random chars in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-at-least-32-random-chars

# Comma-separated allowlist for role=student emails (default: ui.ac.id)
STUDENT_DOMAINS=ui.ac.id

# Public origin (no trailing slash) — used in emailed links + CORS fallback.
# e.g. APP_URL=https://thesis.fkui.ac.id
APP_URL=

# Comma-separated CORS allowlist. Empty = derive from APP_URL. Required for socket.io (SOCKET_ORIGINS may differ from CORS_ORIGINS).
CORS_ORIGINS=

# Trust X-Forwarded-For from one proxy hop (Render public URL is upstream of Node). Default ON in prod.
# Render does not add origin allowlists to OUR Free plan. Use APP_URL + SOCKET_ORIGINS.
TRUST_PROXY=true

# Alerting (optional). Generic webhook (Slack/Teams) + optional alert email.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Email provider: stub (default dev) | resend.
MAIL_PROVIDER=stub
RESEND_API_KEY=
MAIL_FROM=Thesis Selection <no-reply@fkui.ac.id>

# LLM (optional): stub in dev/test; Groq in prod.
GROQ_API_KEY=

# Magic-link tuning
MAGIC_LINK_TTL_SEC=900
MAGIC_LINK_MAX_AGE_DAYS=30

# Exports directory inside container (used by reports).
EXPORT_DIR=/app/data/exports

# Support escalation WhatsApp number (digits only, international format)
SUPPORT_WHATSAPP_NUMBER=

# Built SPA directory override (default: ./web-dist in Docker, ./web/dist locally). Do not set by hand.
WEB_DIST=/app/web-dist
